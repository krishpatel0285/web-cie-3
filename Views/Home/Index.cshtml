@model List<Car>
@{ ViewData["Title"] = "Find Your Next Drive"; }
<section class="hero"><div class="hero-image"></div><div class="hero-shade"></div><div class="container hero-content"><div class="eyebrow"><span class="eyebrow-line"></span> A MORE PERSONAL WAY TO DRIVE</div><h1>Find the car<br>that <em>moves you.</em></h1><p>Discover an exceptional collection of performance icons, modern classics and everyday luxury — selected with intention.</p><div class="hero-buttons"><a class="btn btn-gold" asp-controller="Cars" asp-action="Index">Explore the collection <span>↗</span></a><a class="text-link" href="#featured">Discover our picks <span>↓</span></a></div><div class="hero-stats"><div><strong>08</strong><span>Curated vehicles</span></div><div><strong>01:1</strong><span>Personal guidance</span></div><div><strong>100%</strong><span>Passion for driving</span></div></div></div><div class="hero-caption">THE ART OF THE DRIVE <span>— 01 / 03</span></div></section>
<section class="intro section-pad"><div class="container intro-grid"><div><div class="eyebrow dark"><span class="eyebrow-line"></span> NOT JUST A SHOWROOM</div><h2>Good cars are found.<br><em>Great ones are felt.</em></h2></div><p>We believe choosing a car should feel as good as driving it. Our carefully selected collection brings together design, performance and personality — with honest guidance at every turn.</p></div></section>
<section class="featured section-pad" id="featured"><div class="container"><div class="section-heading"><div><div class="eyebrow dark"><span class="eyebrow-line"></span> THE SHORTLIST</div><h2>Featured <em>machines.</em></h2></div><a class="text-link dark-link" asp-controller="Cars" asp-action="Index">View the full collection <span>↗</span></a></div><div class="car-grid">@foreach (var car in Model.Take(3)) { <article class="car-card"><a class="car-image-wrap" asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"><img src="@car.ImageUrl" alt="@car.Brand @car.Name" loading="lazy"><span class="car-badge">@car.Badge</span><span class="image-arrow">↗</span></a><div class="car-info"><div class="car-kicker">@car.Year · @car.Category</div><h3>@car.Brand <span>@car.Name</span></h3><div class="car-specs"><span>@car.Fuel</span><span>@car.Transmission</span><span>@car.Seats seats</span></div><div class="car-price-row"><div><small>ASKING PRICE</small><strong>₹@car.Price.ToString("N0")</strong></div><a class="round-arrow" asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" aria-label="View car details">↗</a></div></div></article> }</div></div></section>
<section class="experience" id="experience"><div class="experience-image"></div><div class="container experience-content"><div class="eyebrow"><span class="eyebrow-line"></span> THE AUTOHAVEN DIFFERENCE</div><h2>Your next chapter<br>starts <em>behind the wheel.</em></h2><p>From your first shortlist to your first drive, we make the process thoughtful, transparent and entirely yours.</p><div class="experience-points"><div><span>01</span><div><strong>Curated, not crowded</strong><p>Quality over quantity. Every car has a reason to be here.</p></div></div><div><span>02</span><div><strong>Advice without pressure</strong><p>Real conversations to help you choose with confidence.</p></div></div><div><span>03</span><div><strong>Experience it yourself</strong><p>Book a visit and get to know your next car in person.</p></div></div></div><a class="btn btn-gold" asp-controller="Cars" asp-action="Index">Find your car <span>↗</span></a></div></section>
<section class="closing-cta"><div class="container closing-inner"><div><div class="eyebrow dark"><span class="eyebrow-line"></span> YOUR DRIVE, YOUR STORY</div><h2>Something special<br>is <em>waiting for you.</em></h2></div><a class="btn btn-dark" asp-controller="Cars" asp-action="Index">Browse all vehicles <span>↗</span></a></div></section>
