@model List<Car>
@{ ViewData["Title"] = "The Collection"; }
<section class="page-hero"><div class="container"><div class="eyebrow"><span class="eyebrow-line"></span> THE AUTOHAVEN COLLECTION</div><h1>Made for the<br><em>way you move.</em></h1><p>A considered selection of performance, luxury and everyday icons.</p></div></section>
<section class="collection-section section-pad"><div class="container"><form class="filter-bar" method="get"><div class="search-field"><span>⌕</span><input name="q" value="@ViewBag.Query" placeholder="Search make, model or type…" aria-label="Search vehicles"></div><select name="category" aria-label="Filter by category"><option value="All">All categories</option>@foreach (var cat in new[]{"Sports","Supercar","SUV","Coupe","Sedan","Muscle","Electric","Grand Tourer"}) { <option value="@cat" selected="@(ViewBag.Category as string == cat)">@cat</option> }</select><select name="fuel" aria-label="Filter by fuel"><option value="All">All fuel types</option>@foreach (var fuel in new[]{"Petrol","Diesel","Electric"}) { <option value="@fuel" selected="@(ViewBag.Fuel as string == fuel)">@fuel</option> }</select><select name="sort" aria-label="Sort vehicles"><option value="featured">Sort: Featured</option><option value="price-low" selected="@(ViewBag.Sort as string == "price-low")">Price: Low to high</option><option value="price-high" selected="@(ViewBag.Sort as string == "price-high")">Price: High to low</option><option value="year" selected="@(ViewBag.Sort as string == "year")">Newest first</option></select><button class="btn btn-dark filter-submit" type="submit">Apply filters</button></form><div class="collection-meta"><span><strong>@Model.Count</strong> vehicles to discover</span><span>HANDPICKED FOR YOU</span></div>
@if (Model.Count == 0) { <div class="empty-state"><span>⌕</span><h2>No cars found.</h2><p>Try a different search or clear your filters.</p><a class="btn btn-dark" asp-action="Index">Clear filters</a></div> } else { <div class="car-grid collection-grid">@foreach (var car in Model) { <article class="car-card"><a class="car-image-wrap" asp-action="Details" asp-route-id="@car.Id"><img src="@car.ImageUrl" alt="@car.Brand @car.Name" loading="lazy"><span class="car-badge">@car.Badge</span><span class="image-arrow">↗</span></a><div class="car-info"><div class="car-kicker">@car.Year · @car.Category</div><h3>@car.Brand <span>@car.Name</span></h3><div class="car-specs"><span>@car.Fuel</span><span>@car.Transmission</span><span>@car.Seats seats</span></div><div class="car-price-row"><div><small>ASKING PRICE</small><strong>₹@car.Price.ToString("N0")</strong></div><a class="round-arrow" asp-action="Details" asp-route-id="@car.Id" aria-label="View car details">↗</a></div></div></article> }</div> }</div></section>
