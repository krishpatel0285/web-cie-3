@model Car
@{ ViewData["Title"] = Model.Brand + " " + Model.Name; }
<section class="detail-section"><div class="container"><a class="back-link" asp-action="Index">← Back to collection</a><div class="detail-grid"><div class="detail-visual"><img src="@Model.ImageUrl" alt="@Model.Brand @Model.Name"><span class="detail-image-label">AUTOHAVEN SELECT · @Model.Year</span></div><div class="detail-copy"><div class="eyebrow dark"><span class="eyebrow-line"></span> @Model.Badge</div><div class="car-kicker">@Model.Year · @Model.Category</div><h1>@Model.Brand<br><em>@Model.Name</em></h1><p class="detail-description">@Model.Description</p><div class="detail-price"><small>ASKING PRICE</small><strong>₹@Model.Price.ToString("N0")</strong><span>Indicative price · final quote on request</span></div><div class="detail-spec-grid"><div><small>POWERTRAIN</small><strong>@Model.Fuel</strong></div><div><small>TRANSMISSION</small><strong>@Model.Transmission</strong></div><div><small>SEATING</small><strong>@Model.Seats people</strong></div><div><small>EFFICIENCY</small><strong>@(Model.Mileage == 0 ? "Electric" : Model.Mileage + " km/l approx.")</strong></div></div><a class="btn btn-dark btn-wide" asp-controller="Inquiries" asp-action="Create" asp-route-carId="@Model.Id">Book a showroom visit <span>↗</span></a><p class="detail-footnote">No pressure. Just a chance to experience the car for yourself.</p></div></div></div></section>
