@model RegisterViewModel
@{ ViewData["Title"] = "Create your account"; }
<section class="auth-section"><div class="auth-photo"><div class="auth-photo-overlay"></div><div class="auth-photo-copy"><div class="eyebrow"><span class="eyebrow-line"></span> WELCOME TO AUTOHAVEN</div><h2>Your next great<br>drive starts <em>here.</em></h2><p>Save your details and make your showroom experience personal.</p></div></div><div class="auth-panel"><a class="back-link" asp-controller="Home" asp-action="Index">← Back home</a><div class="auth-form-wrap"><div class="eyebrow dark"><span class="eyebrow-line"></span> JOIN THE COLLECTION</div><h1>Create your <em>account.</em></h1><p class="muted">A few details and you're on your way.</p><form asp-action="Register" method="post" class="form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name">Full name</label><input asp-for="Name" placeholder="Your name" autocomplete="name"><span asp-validation-for="Name" class="field-error"></span><label asp-for="Email">Email address</label><input asp-for="Email" placeholder="you@example.com" autocomplete="email"><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password">Password</label><input asp-for="Password" type="password" placeholder="At least 8 characters" autocomplete="new-password"><span asp-validation-for="Password" class="field-error"></span><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" placeholder="Enter password again" autocomplete="new-password"><span asp-validation-for="ConfirmPassword" class="field-error"></span><button class="btn btn-dark btn-wide" type="submit">Create account <span>↗</span></button></form><p class="auth-switch">Already a member? <a asp-action="Login">Sign in</a></p></div></div></section>
