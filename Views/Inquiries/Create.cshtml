@model InquiryViewModel
@{ ViewData["Title"] = "Book a showroom visit"; }
<section class="form-page"><div class="container form-page-grid"><div class="form-page-intro"><div class="eyebrow dark"><span class="eyebrow-line"></span> COME MEET YOUR NEXT CAR</div><h1>Make it a<br><em>real-life thing.</em></h1><p>Tell us a little about yourself and choose a convenient date. Our showroom team will follow up to confirm your visit.</p><div class="visit-note"><span>✳</span><div><strong>Personal, unhurried, yours.</strong><p>Explore the car, ask every question and take your time.</p></div></div></div><div class="form-card"><div class="form-card-top"><span>SHOWROOM APPOINTMENT</span><span>01 / 01</span></div><h2>Let's plan your visit.</h2><p class="muted">You're enquiring about <strong>@Model.CarName</strong></p><form asp-action="Create" method="post" class="form-stack"><input asp-for="CarId" type="hidden"><input asp-for="CarName" type="hidden"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="CustomerName">Full name</label><input asp-for="CustomerName" placeholder="Your full name"><span asp-validation-for="CustomerName" class="field-error"></span><div class="form-two"><div><label asp-for="Email">Email address</label><input asp-for="Email" placeholder="you@example.com"><span asp-validation-for="Email" class="field-error"></span></div><div><label asp-for="Phone">Phone number</label><input asp-for="Phone" placeholder="+91 98765 43210"><span asp-validation-for="Phone" class="field-error"></span></div></div><label asp-for="PreferredDate">Preferred visit date</label><input asp-for="PreferredDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")"><span asp-validation-for="PreferredDate" class="field-error"></span><label asp-for="Message">Anything you'd like us to know <span class="optional">OPTIONAL</span></label><textarea asp-for="Message" rows="3" placeholder="Questions, preferred time, or details..."></textarea><button class="btn btn-dark btn-wide" type="submit">Request my visit <span>↗</span></button><p class="form-disclaimer">This is a visit request, not a confirmed booking. Our team will contact you.</p></form></div></div></section>
