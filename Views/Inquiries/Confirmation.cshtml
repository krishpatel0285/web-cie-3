@model ShowroomInquiry
@{ ViewData["Title"] = "Visit request received"; }
<section class="confirmation-section"><div class="confirmation-card"><div class="confirmation-icon">✓</div><div class="eyebrow dark"><span class="eyebrow-line"></span> REQUEST RECEIVED</div><h1>Consider it a<br><em>great first step.</em></h1><p>Your showroom visit request has been saved. Our team will get in touch to confirm the details.</p><div class="confirmation-details"><div><span>REQUEST REFERENCE</span><strong>AH-@Model.Id.ToString("D5")</strong></div><div><span>VEHICLE</span><strong>@Model.CarName</strong></div><div><span>PREFERRED DATE</span><strong>@Model.PreferredDate.ToString("dd MMM yyyy")</strong></div><div><span>CONTACT EMAIL</span><strong>@Model.Email</strong></div></div><a class="btn btn-dark btn-wide" asp-controller="Cars" asp-action="Index">Continue exploring <span>↗</span></a><a class="text-link dark-link centered-link" asp-controller="Home" asp-action="Index">Return to home</a></div></section>
